# Stremio HTPC: stremio-linux-shell (GTK, WebKit, mpv) with the HTPC web UI.
#
# Build from another clone or branch of the web UI:
#   STREMIO_HTPC_WEB_REPO=/path/to/stremio-web STREMIO_HTPC_WEB_BRANCH=htpc makepkg -si
# Only committed changes are built.

pkgname=stremio-htpc-git
pkgver=5.0.0.beta.43.r30.g345b67179
pkgrel=1
pkgdesc="Stremio for the TV: stremio-linux-shell with a remote-first web UI"
arch=('x86_64')
url="https://github.com/iannisimo/stremio-web"
license=('GPL-2.0-only' 'GPL-3.0-only')
depends=(
    'gtk4'
    'libadwaita'
    'webkitgtk-6.0'
    'mpv'
    'libepoxy' # dlopen()ed by the shell
    'glib2'
    'nodejs' # streaming server and UI server
    'ffmpeg' # streaming server
    'hicolor-icon-theme'
)
makedepends=('cargo' 'git' 'gettext' 'npm')
optdepends=(
    'libnotify: show startup errors'
    'xdg-desktop-portal-impl: background mode and opening links'
)
provides=('stremio-linux-shell')
conflicts=('stremio-linux-shell' 'stremio-linux-shell-git')
options=(!lto !debug)

_webrepo=${STREMIO_HTPC_WEB_REPO:-https://github.com/iannisimo/stremio-web.git}
[[ $_webrepo == /* ]] && _webrepo=file://$_webrepo
_webbranch=${STREMIO_HTPC_WEB_BRANCH:-htpc}
# Shell main after v1.2.2 (hardware decoding, playback CPU fixes, mpv config).
# When bumping, check that its server.js still answers CORS for any origin
# (it does because the shell passes NO_CORS="0", a truthy string).
_shellcommit=97078df902462e613757571d307a9ac16843147a
_pnpm=pnpm@11.8.0

source=(
    "stremio-web::git+${_webrepo}#branch=${_webbranch}"
    "stremio-linux-shell::git+https://github.com/Stremio/stremio-linux-shell.git#commit=${_shellcommit}"
    'stremio-htpc.sh'
    'stremio-htpc-web.js'
    'com.stremio.Stremio.desktop'
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

pkgver() {
    cd stremio-web
    git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd "$srcdir/stremio-linux-shell"
    cargo fetch --locked --target "$(rustc --print host-tuple)"

    cd "$srcdir/stremio-web"
    npx --yes "$_pnpm" install --frozen-lockfile
}

build() {
    cd "$srcdir/stremio-linux-shell"
    CARGO_TARGET_DIR=target STREMIO_LOCALEDIR=/usr/share/locale \
        cargo build --release --frozen

    cd "$srcdir/stremio-web"
    # The UI is updated by pacman, not by a service worker.
    SERVICE_WORKER_DISABLED=true npx --yes "$_pnpm" run build
}

package() {
    install -Dm755 stremio-htpc.sh "$pkgdir/usr/bin/stremio-htpc"
    install -Dm644 stremio-htpc-web.js "$pkgdir/usr/lib/stremio-htpc/stremio-htpc-web.js"
    install -Dm644 com.stremio.Stremio.desktop "$pkgdir/usr/share/applications/com.stremio.Stremio.desktop"

    cd "$srcdir/stremio-web"
    install -d "$pkgdir/usr/share/stremio-htpc/web"
    cp -r --no-preserve=ownership build/. "$pkgdir/usr/share/stremio-htpc/web/"
    find "$pkgdir/usr/share/stremio-htpc/web" -name '*.map' -delete

    cd "$srcdir/stremio-linux-shell"
    install -Dm755 target/release/stremio-linux-shell "$pkgdir/usr/lib/stremio-htpc/stremio"
    install -Dm644 data/server.js "$pkgdir/usr/lib/stremio-htpc/server.js"
    install -Dm644 data/com.stremio.Stremio.gschema.xml \
        "$pkgdir/usr/share/glib-2.0/schemas/com.stremio.Stremio.gschema.xml"
    install -Dm644 data/icons/com.stremio.Stremio.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.stremio.Stremio.svg"
    for mo in target/locale/*/LC_MESSAGES/stremio.mo; do
        install -Dm644 "$mo" "$pkgdir/usr/share/${mo#target/}"
    done
}
